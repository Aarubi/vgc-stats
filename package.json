{
  "name": "vgc-pokedex-bot",
  "version": "1.0.0",
  "description": "Discord bot que consulta a PokeAPI e mostra cards de Pokémon",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy-commands": "node scripts/deploy-commands.js --guild",
    "deploy-commands:global": "node scripts/deploy-commands.js --global",
    "test": "node --test",
    "audit": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10"
  }
}
